# ============================================================
# Finance Dashboard — Monorepo .gitignore
# Covers: Java/Maven (backend) + Node/npm (frontend)
# ============================================================

# -----------------------------------------------
# 🔐 SECRETS — NEVER COMMIT THESE
# -----------------------------------------------
.env
.env.*
!.env.example
application-local.properties
application-secret.properties
*.secret

# -----------------------------------------------
# ☕ Java / Maven (backend: finanace-data/)
# -----------------------------------------------
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package / archive files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# Maven build output
target/
.m2/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Spring Boot dev-tools
spring-boot-devtools.properties

# -----------------------------------------------
# ⚛️  Node / npm (frontend: finance-frontend/)
# -----------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------
# 🖥️  IDE & Editor files
# -----------------------------------------------
# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.sts4-cache/
*.jks

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# VS Code
.vscode/*
!.vscode/extensions.json
*.code-workspace

# -----------------------------------------------
# 🖱️  OS generated files
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------
# 📄 Misc
# -----------------------------------------------
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
