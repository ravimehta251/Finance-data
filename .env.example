# ============================================================
# Finance Dashboard — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# ⚠️  NEVER commit .env to version control!
# ============================================================

# -----------------------------------------------
# Backend (finanace-data)
# -----------------------------------------------

# JWT secret key — MUST be at least 64 characters for HS512 algorithm.
# Generate a strong key: openssl rand -hex 64
JWT_SECRET=replace_this_with_a_secure_random_64_char_secret_key_for_hs512_algorithm

# JWT token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Server port (default: 8080)
PORT=8080

# -----------------------------------------------
# Frontend (finance-frontend)
# -----------------------------------------------

# Backend API base URL (Vite env var — must start with VITE_)
VITE_API_BASE_URL=http://localhost:8080/api
